+package io.trino.sql.query;
+
+import io.trino.Session;
+import org.junit.jupiter.api.Test;
+
+import static io.trino.SessionTestUtils.TEST_SESSION;
+import static org.assertj.core.api.Assertions.assertThat;
+
+public class TestMergeJoinRepeatedKeys
+{
+    @Test
+    public void testRepeatedJoinSymbol()
+    {
+        try (QueryAssertions assertions = new QueryAssertions()) {
+            Session merge = Session.builder(TEST_SESSION)
+                    .setSystemProperty("prefer_merge_join", "FORCE")
+                    .setSystemProperty("join_distribution_type", "PARTITIONED")
+                    .setSystemProperty("join_reordering_strategy", "NONE")
+                    .build();
+            for (String join : new String[] {"JOIN", "LEFT JOIN", "RIGHT JOIN", "FULL JOIN"}) {
+                String query = "SELECT l.x, r.x, r.y FROM (VALUES 1, 2, 3) l(x) " + join
+                        + " (VALUES (1, 1), (2, 3), (3, 3)) r(x, y) ON l.x = r.x AND l.x = r.y";
+                assertThat(assertions.query(merge, query)).matches(query);
+                String mirrored = "SELECT l.x, l.y, r.x FROM (VALUES (1, 1), (2, 3), (3, 3)) l(x, y) " + join
+                        + " (VALUES 1, 2, 3) r(x) ON l.x = r.x AND l.y = r.x";
+                assertThat(assertions.query(merge, mirrored)).matches(mirrored);
+            }
+        }
+    }
+}
