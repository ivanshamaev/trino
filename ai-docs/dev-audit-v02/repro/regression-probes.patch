+        var filterCalls = new java.util.concurrent.atomic.AtomicInteger();
+        JoinFilterFunctionFactory filter = (_, _, _) -> (_, _, _) -> {
+            filterCalls.incrementAndGet();
+            return false;
+        };
+        var manager = new JoinBridgeManager<>(false, bridge, ImmutableList.of(BIGINT));
+        var factory = auditV02ProbeFactory(manager, Optional.of(filter));
+        var operator = factory.create(driverContext.addOperatorContext(0, NODE_ID, "probe"), io.trino.operator.WorkProcessor.of(repeatedPage(7, 1)));
+        driverContext.getYieldSignal().forceYieldForTesting();
+        try {
+            operator.getOutputPages().process();
+            System.out.println("AUDIT_V02 filterCallsWithYieldSet=" + filterCalls.get());
+            assertThat(filterCalls.get()).isLessThan(200_000);
+        }
+        finally {
+            operator.close();
+            factory.close();
+            driverContext.getYieldSignal().resetYieldForTesting();
+        }
+    }
