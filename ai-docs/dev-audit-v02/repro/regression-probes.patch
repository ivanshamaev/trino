+                    getSession().getCatalog().orElseThrow(),
+                    getSession().getSchema().orElseThrow());
+            org.apache.iceberg.DataFile original;
+            try (var files = icebergTable.newScan().planFiles()) {
+                original = files.iterator().next().file().copy();
+            }
+            var legacy = original.copy();
+            var sortOrderField = legacy.getClass().getSuperclass().getDeclaredField("sortOrderId");
+            sortOrderField.setAccessible(true);
+            sortOrderField.set(legacy, null);
+            assertThat(legacy.sortOrderId()).isNull();
+            icebergTable.newOverwrite().deleteFile(original).addFile(legacy).commit();
+            try (var files = icebergTable.newScan().planFiles()) {
+                assertThat(files.iterator().next().file().sortOrderId()).isNull();
+            }
+            Session off = Session.builder(getSession()).setSystemProperty("prefer_merge_join", "OFF").build();
+            assertQuery(off, "SELECT k FROM " + table.getName(), "VALUES BIGINT '1'");
+        }
