+    @Test
+    public void testAuditV02ReplayAmplification(@TempDir Path spillPath)
+            throws Exception
+    {
+        double largestRatio = 0;
+        for (int pageCount : List.of(768, 3072, 12288)) {
+            List<Page> pages = new ArrayList<>();
+            RowPagesBuilder probe = rowPagesBuilder(BIGINT);
+            MaterializedResult.Builder expected = MaterializedResult.resultBuilder(BIGINT, BIGINT);
+            for (int page = 0; page < pageCount; page++) {
+                long key = page / 3;
+                pages.add(repeatedPage(key, 8));
+                if (page % 3 == 0) {
+                    probe.row(key);
+                }
+                for (int position = 0; position < 8; position++) {
+                    expected.row(key, key);
+                }
+            }
+            SpillIo io = assertSpilledJoin(spillPath, JoinType.INNER, pages, probe.build(), expected.build(), Optional.empty());
+            largestRatio = (double) io.readBytes() / io.writtenBytes();
+            System.out.printf(
+                    "AUDIT_V02 pages=%s replayedPages=%s writtenBytes=%s readBytes=%s readWriteRatio=%.4f%n",
+                    pageCount,
+                    io.replayedPages(),
+                    io.writtenBytes(),
+                    io.readBytes(),
+                    largestRatio);
+        }
+        assertThat(largestRatio).as("Linear replay IO for groups spanning three pages").isLessThanOrEqualTo(4);
+    }
