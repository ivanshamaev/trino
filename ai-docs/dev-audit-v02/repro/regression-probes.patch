+        try (TestTable table = new TestTable(getQueryRunner()::execute, "audit_v02_null_sort", "(k BIGINT) WITH (sorted_by = ARRAY['k'])")) {
+            assertUpdate("INSERT INTO " + table.getName() + " VALUES 1", 1);
+            var icebergTable = IcebergTestUtils.loadTable(
+                    table.getName(),
+                    IcebergTestUtils.getHiveMetastore(getQueryRunner()),
